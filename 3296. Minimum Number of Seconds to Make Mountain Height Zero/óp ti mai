class Solution {
public:
    long long minNumberOfSeconds(int H, vector<int>& wt) {
        int maxW = *max_element(wt.begin(), wt.end());
        long long l = 1, r = (long long)maxW * H * (H + 1) / 2;
        long long ans = 0;

        while (l <= r) {
            long long mid = (l + r) / 2;
            long long total = 0;
            for (int t : wt) {
                long long work = mid / t;
                long long k = (long long)((sqrt(1 + 8.0 * work) - 1) / 2);
                total += k;
                if (total >= H) break;
            }
            if (total >= H) {
                ans = mid;
                r = mid - 1;
            } else {
                l = mid + 1;
            }
        }
        return ans;
    }
};
