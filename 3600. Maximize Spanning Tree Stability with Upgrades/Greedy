class Solution {
    struct DSU {
        vector<int> p;
        
        DSU(int n) : p(n, -1) {}
        
        int find(int x) {
            return p[x] < 0 ? x : p[x] = find(p[x]);
        }
        
        bool unite(int a, int b) {
            a = find(a); 
            b = find(b);
            
            if (a == b) return false;
            
            p[b] = a;
            return true;
        }
    };

public:
    int maxStability(int n, vector<vector<int>>& edges, int k) {
        DSU dsu(n);
        int used = 0;
        int minForced = 2e5;
        int minLast = 2e5;
        int minAny = 2e5;
        
        vector<array<int, 3>> optional;
        optional.reserve(edges.size());
        
        for (auto& e : edges) {
            if (e[3]) {
                if (!dsu.unite(e[0], e[1])) 
                    return -1;
                    
                used++;
                minForced = min(minForced, e[2]);
            } else {
                optional.push_back({e[2], e[0], e[1]});
            }
        }
        
        sort(optional.begin(), optional.end(), greater());
        
        for (auto& [strength, u, v] : optional) {
            if (dsu.unite(u, v)) {
                used++;
                
                if (used == n - k - 1) 
                    minLast = strength;
                    
                minAny = strength;
            }
        }
        
        if (used != n - 1) 
            return -1;
        
        int doubleFactor = k ? 2 : 1;
        return min({minForced, minLast, doubleFactor * minAny});
    }
};
