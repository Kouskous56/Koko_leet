class Solution {
public:
    int findMaxLength(vector<int>& nums) {
        unordered_map<int, int> first;
        first[0] = -1;
        int sum = 0, best = 0;
        for (int i = 0; i < nums.size(); i++) {
            sum += nums[i] ? 1 : -1;
            if (first.count(sum))
                best = max(best, i - first[sum]);
            else
                first[sum] = i;
        }
        return best;
    }
};
