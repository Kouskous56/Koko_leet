class Solution {
public:
    int findMaxLength(vector<int>& nums) {
        int n = nums.size();
        vector<int> first(2 * n + 1, -2);
        int off = n, sum = 0, best = 0;
        first[off] = -1;
        
        for (int i = 0; i < n; i++) {
            sum += nums[i] ? 1 : -1;
            int idx = sum + off;
            if (first[idx] != -2)
                best = max(best, i - first[idx]);
            else
                first[idx] = i;
        }
        return best;
    }
};
