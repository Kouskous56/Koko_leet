class Solution {
public:
    int shoppingOffers(vector<int>& price, vector<vector<int>>& special, vector<int>& needs) {
        map<vector<int>, int> memo;
        return dfs(price, special, needs, memo);
    }

private:
    int dfs(vector<int>& price, vector<vector<int>>& special, vector<int> needs, map<vector<int>, int>& memo) {
        if (memo.count(needs)) return memo[needs];

        int cost = 0;
        for (int i = 0; i < needs.size(); ++i) {
            cost += needs[i] * price[i];
        }

        for (auto& offer : special) {
            vector<int> remaining = needs;
            bool valid = true;
            for (int i = 0; i < needs.size(); ++i) {
                if (offer[i] > remaining[i]) {
                    valid = false;
                    break;
                }
                remaining[i] -= offer[i];
            }
            if (valid) {
                cost = min(cost, offer.back() + dfs(price, special, remaining, memo));
            }
        }

        memo[needs] = cost;
        return cost;
    }
};
