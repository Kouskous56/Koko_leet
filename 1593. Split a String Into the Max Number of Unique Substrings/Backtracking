class Solution {
public:
    int maxUniqueSplit(string s) {
        int n = s.length();
        int ans = 0;
        unordered_set<string> used;
        
        function<void(int, int)> dfs = [&](int start, int cnt) {
            if (start == n) {
                ans = max(ans, cnt);
                return;
            }
            
            for (int end = start + 1; end <= n; ++end) {
                string sub = s.substr(start, end - start);
                if (!used.count(sub)) {
                    used.insert(sub);
                    dfs(end, cnt + 1);
                    used.erase(sub);
                }
            }
        };
        
        dfs(0, 0);
        return ans;
    }
};
